#pre information
preinfo: nproc=40, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', part_path='./partition', out_path='./output', disp_dof=0, pot_dof=1, pot_type='electric'

#mesh information
mesh: xfile='ip_coord_x', yfile='ip_coord_y', zfile='ip_coord_z', &
confile='ip_connectivity', idfile='ip_material_id', gfile='ip_ghost', fsfile='ip_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='ip_ssbcux', &
    uyfile='ip_ssbcuy', &
    uzfile='ip_ssbcuz', &
    phifile='ip_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='ip_infinite_surface', &
      mat_type='define', &
      imat_inf=3, &
      pole0='user', &
      coord0=0.0000 0.0000 5.0000, &
      pole_type='point', &
      rinf=500000.0, &
      valinf=0, &

# electrical current
ecurrent: ecfile='ip_electrical_current'

#material list
material: matfile='ip_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: epot=1, inf=1, cell=1

#devel
devel: nondim=0

#pre information
preinfo: nproc=40, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', part_path='./partition', out_path='./output', disp_dof=0, pot_dof=1, pot_type='electric'

#mesh information
mesh: xfile='example_coord_x', yfile='example_coord_y', zfile='example_coord_z', &
confile='example_connectivity', idfile='example_material_id', gfile='example_ghost', fsfile='example_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='example_ssbcux', &
    uyfile='example_ssbcuy', &
    uzfile='example_ssbcuz', &
    phifile='example_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='example_infinite_surface', &
      mat_type='define', &
      imat_inf=3, &
      pole0='user', &
      coord0=0.0000 0.0000 0.0000, &
      pole_type='point', &
      rinf=550.0, &
      valinf=0, &

# electrical current
ecurrent: ecfile='example_electrical_current'

#material list
material: matfile='example_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: cell=1, epot=1

#devel
devel: nondim=0

#pre information
preinfo: nproc=40, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', part_path='./partition', out_path='./output', disp_dof=0, pot_dof=1, pot_type='charge'

#mesh information
mesh: xfile='cubemesh1_coord_x', yfile='cubemesh1_coord_y', zfile='cubemesh1_coord_z', &
confile='cubemesh1_connectivity', idfile='cubemesh1_material_id', gfile='cubemesh1_ghost', fsfile='cubemesh1_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='cubemesh1_ssbcux', &
    uyfile='cubemesh1_ssbcuy', &
    uzfile='cubemesh1_ssbcuz', &
    phifile='cubemesh1_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='cubemesh1_infinite_surface', &
      mat_type='define', &
      imat_inf=3, &
      pole0='user', &
      coord0=0.0000 0.0000 -10.0000, &
      pole_type='point', &
      rinf=50.0, &
      valinf=0, &

#material list
material: matfile='cubemesh1_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: epot=1

#devel
devel: nondim=0

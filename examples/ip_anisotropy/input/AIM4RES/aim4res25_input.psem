#pre information
preinfo: nproc=160, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', part_path='./partition', out_path='./output', disp_dof=0, pot_dof=1, pot_type='electric'

#mesh information
mesh: xfile='aim4res25_coord_x', yfile='aim4res25_coord_y', zfile='aim4res25_coord_z', &
confile='aim4res25_connectivity', idfile='aim4res25_material_id', gfile='aim4res25_ghost', fsfile='aim4res25_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='aim4res25_ssbcux', &
    uyfile='aim4res25_ssbcuy', &
    uzfile='aim4res25_ssbcuz', &
    phifile='aim4res25_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='aim4res25_infinite_surface', &
      mat_type='define', &
      imat_inf=3, &
      pole0='user', &
      coord0=75.0000 15.0000 0.0000, &
      pole_type='point', &
      rinf=500.0, &
      valinf=0, &

# electrical current
ecurrent: ecfile='aim4res25_electrical_current'

#material list
material: matfile='aim4res25_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: cell=1, epot=1

#devel
devel: nondim=0

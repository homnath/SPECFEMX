#pre information
preinfo: nproc=40, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', part_path='./partition', out_path='./output', disp_dof=0, pot_dof=1, pot_type='electric'

#mesh information
mesh: xfile='mountain_valley_coord_x', yfile='mountain_valley_coord_y', zfile='mountain_valley_coord_z', &
confile='mountain_valley_connectivity', idfile='mountain_valley_material_id', gfile='mountain_valley_ghost', fsfile='mountain_valley_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='mountain_valley_ssbcux', &
    uyfile='mountain_valley_ssbcuy', &
    uzfile='mountain_valley_ssbcuz', &
    phifile='mountain_valley_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='mountain_valley_infinite_surface', &
      mat_type='define', &
      imat_inf=4, &
      pole0='user', &
      coord0=0.0000 0.0000 0.0000, &
      pole_type='point', &
      rinf=2000.0, &
      valinf=0, &

# electrical current
ecurrent: ecfile='mountain_valley_electrical_current'

#material list
material: matfile='mountain_valley_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: cell=1, epot=1

#devel
devel: nondim=0

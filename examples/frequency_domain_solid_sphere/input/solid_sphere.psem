#pre information
preinfo: nproc=40, method='sem', &
         ngllx=3, nglly=3,       &
         ngllz=3, nenode=8,      &
         ngnode=8, inp_path='./input', &
         out_path='./output/', &
         pot_dof=0, disp_dof=1, grav0=0

#mesh information
mesh: xfile='solid_sphere_coord_x', &
      yfile='solid_sphere_coord_y', &
      zfile='solid_sphere_coord_z', &
      confile='solid_sphere_connectivity', &
      fsfile='solid_sphere_free_surface', &
      idfile='solid_sphere_material_id', &
      gfile='solid_sphere_ghost'

#boundary conditions
bc: ubc=1, &
    uxfile='solid_sphere_ssbcux', &
    uyfile='solid_sphere_ssbcuy', &
    uzfile='solid_sphere_ssbcuz'

#solid_spherequake slip or CMT file. 0 = slip,1 = CMT, 2 = Finite fault, 3 = Slip with split node
eqsource: type=1, cmtfile='CMTSOLUTION_CORRECT',mapto='GLOBE'

#material list
material: matfile='solid_sphere_material_list',density=1

#control parameters
control: ksp_tol=1e-6, ksp_maxiter=2000, nl_tol=1e-4, nl_maxiter=1

# Station information
station: sfile='solid_sphere_stations'
#control parameters
step: type=1, step=0.0001, start=0.001, end=0.006

#save data
save: disp=1, strain=1, fsplot=1

#devel
#devel: nondim=0, mgll=1
devel: nondim=1

#pre information
preinfo: nproc=1, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, inp_path='./input', out_path='./output/'

#mesh information
mesh: xfile='validation1_coord_x', yfile='validation1_coord_y', zfile='validation1_coord_z', &
confile='validation1_connectivity', &
fsfile='validation1_free_surface', &
idfile='validation1_material_id', gfile='validation1_ghost'

#boundary conditions
bc: uxfile='validation1_ssbcux', uyfile='validation1_ssbcuy', uzfile='validation1_ssbcuz'

#material list
material: matfile='validation1_material_list',plastic=1

#body load
bodyload: selfweight=1

#control parameters
control: cg_tol=1e-8, cg_maxiter=1000, nl_tol=0.0005, nl_maxiter=30

#save data options
save: disp=1

devel: nondim=0

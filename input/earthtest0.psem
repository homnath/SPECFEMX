#pre information
preinfo: nproc=40, method='sem', &
         ngllx=3, nglly=3,       &
         ngllz=3, nenode=8,      &
         ngnode=8, inp_path='./input', &
         out_path='./output_trial/', &
         pot_dof=0, disp_dof=1, grav0=0

#mesh information
mesh: xfile='earthtest0_coord_x', &
      yfile='earthtest0_coord_y', &
      zfile='earthtest0_coord_z', &
      confile='earthtest0_connectivity', &
      fsfile='earthtest0_free_surface', &
      idfile='earthtest0_material_id', &
      gfile='earthtest0_ghost'

#boundary conditions
bc: ubc=1, &
    uxfile='earthtest0_ssbcux', &
    uyfile='earthtest0_ssbcuy', &
    uzfile='earthtest0_ssbcuz'

#earthtest0quake slip or CMT file. 0 = slip,1 = CMT, 2 = Finite fault, 3 = Slip with split node
eqsource: type=1, cmtfile='CMTSOLUTION_CORRECT'

#material list
material: matfile='earthtest0_material_list',density=1

#control parameters
control: ksp_tol=1e-6, ksp_maxiter=1000, nl_tol=1e-4, nl_maxiter=1

#control parameters
step: type=1, step=0.0001, start=0.001, end=0.006

#save data
save: disp=1, strain=1, fsplot=1

#devel
#devel: nondim=0, mgll=1
devel: nondim=1

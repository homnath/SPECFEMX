#pre information
preinfo: nproc=40, method='sem', &
         ngllx=3, nglly=3,       &
         ngllz=3, nenode=8,      &
         ngnode=8, inp_path='./input', &
         out_path='./output_trial/', &
         pot_dof=0, disp_dof=1, grav0=0

#mesh information
mesh: xfile='earth_coord_x', &
      yfile='earth_coord_y', &
      zfile='earth_coord_z', &
      confile='earth_connectivity', &
      fsfile='earth_free_surface', &
      idfile='earth_material_id', &
      gfile='earth_ghost'

#boundary conditions
bc: ubc=1, &
    uxfile='earth_ssbcux', &
    uyfile='earth_ssbcuy', &
    uzfile='earth_ssbcuz'

#earthquake slip or CMT file. 0 = slip,1 = CMT, 2 = Finite fault, 3 = Slip with split node
eqsource: type=3, faultslipfile_plus='earth_fault_plus', &
faultslipfile_minus='earth_fault_minus',shalf=1

#material list
material: matfile='earth_material_list',density=1

#control parameters
control: ksp_tol=1e-6, ksp_maxiter=1000, nl_tol=1e-4, nl_maxiter=1

#control parameters
step: type=1, step=0.0001, start=0.001, end=0.006

#save data
save: disp=1, strain=1, fsplot=1

#devel
#devel: nondim=0, mgll=1
devel: nondim=1

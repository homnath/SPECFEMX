#pre information
preinfo: nproc=40, method='sem', ngllx=3, nglly=3, ngllz=3, nenode=8, ngnode=8, &
inp_path='./input', out_path='./output/', disp_dof=0, pot_dof=1, pot_type='magnetic'

#mesh information
mesh: xfile='small_coord_x', yfile='small_coord_y', zfile='small_coord_z', &
confile='small_connectivity', idfile='small_material_id', gfile='small_ghost', fsfile='small_infinite_surface'

#boundary conditions
bc: ubc=0, &
    uxfile='small_ssbcux', &
    uyfile='small_ssbcuy', &
    uzfile='small_ssbcuz', &
    phifile='small_ssbcphi', &
    infbc=1, &
      add_infmesh=1, &
      infrfile='small_infinite_surface', &
      mat_type='define', &
      imat_inf=3, &
      pole0='user', &
      coord0=0.0000 0.0000 5.0000, &
      pole_type='point', &
      rinf=20000.0, &
      valinf=0, &

# magnetic traction
mtraction: trfile='small_traction_surface'

#material list
material: matfile='small_material_list',density=1

#control parameters
control: ksp_tol=1e-7, ksp_maxiter=20000

#save data
save: mpot=1, magb=1, inf=1

#devel
devel: nondim=0
